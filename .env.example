# Необязательно (нужно для ЯМ/Звук поиска и скачивания, Spotify плейлистов)
YM_TOKEN=
ZVUK_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Качество по умолчанию: flac | aac320
DEFAULT_QUALITY=aac320

# Для доступа к YouTube/Spotify из РФ — HTTP/SOCKS прокси, напр. http://user:pass@host:8080
