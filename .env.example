BOT_TOKEN=123456:ABC-DEF...
WEBAPP_URL=https://your-tunnel.trycloudflare.com
ADMIN_IDS=123456789

# Необязательно (нужно для ЯМ/Звук поиска и скачивания, Spotify плейлистов)
YM_TOKEN=
ZVUK_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Качество по умолчанию: flac | aac320
DEFAULT_QUALITY=aac320

# Для доступа к YouTube/Spotify из РФ — HTTP/SOCKS прокси, напр. http://user:pass@host:8080
PROXY_URL=

# Исключение: русский прокси ТОЛЬКО для анонимных запросов Яндекс.Музыки
# (импорт публичных плейлистов без токена; ЯМ отдаёт 451 с зарубежных IP).
YM_PROXY_URL=

# DEBUG-режим Mini App (локальный браузер без Telegram)
DEV_MODE=1

# ---- Музыкальная подсистема (пакет music/) ----
# Включить /music, кнопку «Музыка» и очередь загрузок
MUSIC_ENABLED=1
# Перехватывать обычный текст как поиск музыки (0 — только /music и кнопка)
MUSIC_AUTO_TEXT=0

# Необязательные настройки (значения по умолчанию указаны в комментариях)
# MUSIC_DATA_DIR=data/music
# MUSIC_MAX_FILE_MB=200
# MUSIC_MAX_UPLOAD_MB=50
# MUSIC_MIN_DURATION_SEC=8
# MUSIC_MAX_DURATION_SEC=10800
# MUSIC_WORKERS=3
# MUSIC_USER_ACTIVE_JOBS=2
# MUSIC_USER_DAILY_JOBS=60
# MUSIC_RESULTS_LIMIT=12
# MUSIC_PROVIDER_RESULTS=8
# MUSIC_SEARCH_TIMEOUT=12
# MUSIC_PROVIDER_TIMEOUT=10
# MUSIC_DOWNLOAD_TIMEOUT=180
# MUSIC_JOB_TIMEOUT=420
# MUSIC_JOB_ATTEMPTS=3
# MUSIC_RETRY_BACKOFF=2
# MUSIC_TEMP_TTL_HOURS=6
# MUSIC_CACHE_TTL_DAYS=14
# MUSIC_CACHE_MAX_MB=4096
# MUSIC_RATE_PER_MINUTE=20
# MUSIC_MAX_COVER_MB=15
# MUSIC_HOST_CONCURRENCY=2
# MUSIC_ARCHIVE_ENABLED=1
# MUSIC_BANDCAMP_ENABLED=1
# MUSIC_BLOCK_PRIVATE_IPS=1
# MUSIC_EXTRA_ALLOWED_HOSTS=
# MUSIC_PROXY_URL=            # по умолчанию используется PROXY_URL
# MUSIC_CREDENTIAL_KEY=       # ключ шифрования кредов в БД (по умолчанию BOT_TOKEN)
# MUSIC_FFMPEG_TIMEOUT=180
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# Jamendo: бесплатный client_id — https://developer.jamendo.com/v3.0
JAMENDO_CLIENT_ID=
# SoundCloud: только официальный API и треки с официальной загрузкой
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# Spotify для музыки использует SPOTIFY_CLIENT_ID/SECRET выше:
# адаптер отдаёт только метаданные и официальную ссылку.

