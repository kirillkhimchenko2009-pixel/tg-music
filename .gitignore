# python
__pycache__/
*.pyc

# venv / node
.venv/
frontend/node_modules/

# built static is shipped inside the Space image
frontend/dist/
!frontend/dist/

# secrets are not in the repo (env vars / HF Secrets)
.env

# neon connection strings
*.neon.env

# runtime data: logs, audio cache, db, tunnel state
data/*.log
data/*.err
data/*.out
data/*.lock
data/lock_*.lock
data/audio/
data/music.db
data/music.db-*
data/webapp_url.txt
data/tunnel_url.txt

# runtime artifacts: обложки, скачанные при поиске, и временные файлы
data/covers/
data/temp/

# binaries are not in the repo
tools/*.exe
